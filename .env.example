# Multimodal demo defaults: no vendor SDK is required.
# simulation = built-in signal generator
# external   = receive real samples from your device bridge
EEG_SOURCE=simulation
EMG_SOURCE=simulation

# Vision is browser camera metadata by default.
VISION_SOURCE=browser

# Backward compatibility with the old demo setting:
# DATA_SOURCE=simulation

# Optional: protect external EEG/EMG ingest endpoints.
# The same token is accepted by both modalities.
# EEG_INGEST_TOKEN=change-me
