# simulation = built-in demo data
# external   = accept real EEG samples from a device/bridge via /api/eeg/ingest or /ws/eeg/ingest
# emotiv     = legacy EMOTIV Cortex mode
DATA_SOURCE=external

# Optional: protect external EEG ingest endpoints with an HTTP header / WS query token.
# EEG_INGEST_TOKEN=change-me

# Legacy EMOTIV settings (only needed when DATA_SOURCE=emotiv)
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=
EMOTIV_CA_CERT=
EMOTIV_HEADSET_ID=
